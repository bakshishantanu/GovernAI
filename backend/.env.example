# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real keys.

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase JWT signing secret. Required — the API refuses all logins without it.
SUPABASE_JWT_SECRET=

# Local development only. When "true", the literal token "dummy-token" is
# accepted as an admin user so the frontend works without a Supabase project.
# Leave unset (or "false") anywhere the app is reachable from the internet.
AUTH_ALLOW_DEV_TOKEN=false
